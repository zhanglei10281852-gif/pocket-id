+	testutils "github.com/pocket-id/pocket-id/backend/internal/utils/testing"
+)
+
+// rotateAndReload rotates the signing key like the key-rotate command would, then forces the running service to reload it
+func rotateAndReload(t *testing.T, svc *JwtService, alg, crv string, retention time.Duration) jwkutils.RotationResult {
+	t.Helper()
+
+	result, err := jwkutils.RotateSigningKeys(t.Context(), svc.db, svc.envConfig, svc.instanceID, alg, crv, retention, time.Now())
+	require.NoError(t, err)
+	require.NoError(t, svc.ReloadSigningKeys(t.Context()), "The running signer must reload the rotated active generation")
+	return result
+}
+
+// expireRetiredGeneration rewrites the set so every retired generation's compatibility deadline is in the past
+func expireRetiredGeneration(t *testing.T, db *gorm.DB, envConfig *common.EnvConfigSchema, instanceID string) {
+	t.Helper()
+
+	store, err := jwkutils.GetSigningKeySetStore(db, envConfig, instanceID)
+	require.NoError(t, err)
+	set, rawValue, err := store.LoadSet(t.Context())
+	require.NoError(t, err)
+
+	past := time.Now().Add(-time.Minute)
+	for i := range set.Generations {
+		if !set.Generations[i].Active() {
+			set.Generations[i].RetainUntil = &past
+		}
+	}
+	set.Version++
+
+	swapped, err := store.CompareAndSwapSet(t.Context(), rawValue, set)
+	require.NoError(t, err)
+	require.True(t, swapped)
+}
+
+func signTokenForTest(t *testing.T, alg jwxjwa.KeyAlgorithm, key jwxjwk.Key, issuer string, expiry time.Time) string {
+	t.Helper()
+
+	token, err := jwxjwt.NewBuilder().
+		Issuer(issuer).
+		Subject("user-1").
+		IssuedAt(time.Now()).
+		Expiration(expiry).
+		Build()
+	require.NoError(t, err)
+	signed, err := jwxjwt.Sign(token, jwxjwt.WithKey(alg, key))
+	require.NoError(t, err)
+	return string(signed)
+}
+
+// captureJWKSAlg extracts the alg value for a given kid from a raw JWKS document
+func captureJWKSAlg(t *testing.T, raw []byte, kid string) string {
+	t.Helper()
+
+	set, err := jwxjwk.ParseString(string(raw))
+	require.NoError(t, err)
+	key, ok := set.LookupKeyID(kid)
+	require.True(t, ok, "kid %s must be present in the JWKS", kid)
+	alg, ok := key.Algorithm()
+	require.True(t, ok)
+	return `"` + alg.String() + `"`
+}
+
+func TestSigningKeyGenerationsJWKS(t *testing.T) {
+	db := testutils.NewDatabaseForTest(t)
+	envConfig := newTestEnvConfig()
+	instanceID, err := instanceid.Load(t.Context(), db)
+	require.NoError(t, err)
+	svc := initJwtService(t, db, instanceID, nil, envConfig)
+
+	firstKid, ok := svc.GetKeyID()
+	require.True(t, ok)
+	require.NotEmpty(t, firstKid)
+
+	// Rotate RS256 -> ES256 while the service keeps running
+	rotation := rotateAndReload(t, svc, "ES256", "", 48*time.Hour)
+	require.Equal(t, firstKid, rotation.RetiredKid)
+
+	// The JWKS must publish both public keys
+	jwksJSON, err := svc.GetPublicJWKSAsJSON()
+	require.NoError(t, err)
+	jwksString := string(jwksJSON)
+	assert.Contains(t, jwksString, firstKid, "JWKS must keep the retired kid within its compatibility window")
+	assert.Contains(t, jwksString, rotation.NewActiveKid, "JWKS must publish the new active kid")
+	assert.Equal(t, `"RS256"`, captureJWKSAlg(t, jwksJSON, firstKid))
+	assert.Equal(t, `"ES256"`, captureJWKSAlg(t, jwksJSON, rotation.NewActiveKid))
+
+	// The JWKS must never leak private key material or the symmetric session key
+	assert.NotContains(t, jwksString, `"d"`, "JWKS must not contain RSA private material")
+	assert.NotContains(t, jwksString, `"p"`, "JWKS must not contain RSA private primes")
+	assert.NotContains(t, jwksString, `"k"`, "JWKS must not contain symmetric private material")
+	sessionKid, _ := svc.sessionKey.KeyID()
+	assert.NotContains(t, jwksString, sessionKid, "JWKS must never contain the HS256 session key kid")
+	assert.NotContains(t, jwksString, jwxjwa.OctetSeq().String(), "JWKS must never contain symmetric keys")
+
+	// Discovery advertises every published algorithm, active first
+	algs, err := svc.GetKeyAlgorithms()
+	require.NoError(t, err)
+	assert.Equal(t, []string{"ES256", "RS256"}, algs)
+
+	// The active kid is the new one
+	activeKid, _ := svc.GetKeyID()
+	assert.Equal(t, rotation.NewActiveKid, activeKid)
+}
+
+func TestSigningKeyGenerationsVerifyOldTokensByKid(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		alg       string
+		crv       string
+		nextAlg   string
+		nextCrv   string
+		retiredIs func(any) bool
+	}{
+		{name: "RS384", alg: "RS384", nextAlg: "ES256", retiredIs: func(k any) bool { _, ok := k.(*rsa.PublicKey); return ok }},
+		{name: "ES256", alg: "ES256", nextAlg: "RS256", retiredIs: func(k any) bool { _, ok := k.(*ecdsa.PublicKey); return ok }},
+		{name: "EdDSA", alg: "EdDSA", crv: "Ed25519", nextAlg: "ES256", retiredIs: func(k any) bool { _, ok := k.(ed25519.PublicKey); return ok }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			db := testutils.NewDatabaseForTest(t)
+			envConfig := newTestEnvConfig()
+			instanceID, err := instanceid.Load(t.Context(), db)
+			require.NoError(t, err)
+			svc := initJwtService(t, db, instanceID, nil, envConfig)
+
+			// First rotation creates the generation under test, the second one retires it so it lands in the JWKS window
+			retiredRotation := rotateAndReload(t, svc, tc.alg, tc.crv, time.Hour)
+			loadedRetired, err := jwkutils.LoadSigningKeySet(t.Context(), db, envConfig, instanceID)
+			require.NoError(t, err)
+			retiredKey := loadedRetired.Keys[retiredRotation.NewActiveKid]
+			require.NotNil(t, retiredKey)
+			retiredAlg, _ := retiredKey.Algorithm()
+			rotateAndReload(t, svc, tc.nextAlg, tc.nextCrv, time.Hour)
+
+			// Sign a token with the retired key, as an application holding a pre-rotation token would have
+			tokenString := signTokenForTest(t, retiredAlg, retiredKey, envConfig.AppURL, time.Now().Add(time.Minute))
+
+			// The retired kid resolves to its raw public key for go-jose/fosite verification
+			rawPublic, ok := svc.GetVerificationKey(retiredRotation.NewActiveKid)
+			require.True(t, ok, "Retired kid must resolve to a verification key")
+			assert.True(t, tc.retiredIs(rawPublic), "Resolved key must be the retired algorithm's raw public key")
+
+			// Verification against the published key set works without picking the active key
+			keySet, err := svc.GetVerificationKeySet()
+			require.NoError(t, err)
+			parsed, err := jwxjwt.ParseString(tokenString,
+				jwxjwt.WithValidate(true),
+				jwxjwt.WithKeySet(keySet),
+				jwxjwt.WithIssuer(envConfig.AppURL),
+			)
+			require.NoError(t, err, "A token signed by the retired generation must verify through the JWKS key set")
+			subject, _ := parsed.Subject()
+			assert.Equal(t, "user-1", subject)
+
+			// An unknown kid does not resolve and must not fall back silently
+			_, ok = svc.GetVerificationKey("does-not-exist")
+			assert.False(t, ok)
+		})
+	}
+}
+
+func TestSigningKeyGenerationsReloadPicksUpRotation(t *testing.T) {
+	db := testutils.NewDatabaseForTest(t)
+	envConfig := newTestEnvConfig()
+	instanceID, err := instanceid.Load(t.Context(), db)
+	require.NoError(t, err)
+	svc := initJwtService(t, db, instanceID, nil, envConfig)
+
+	originalKid, _ := svc.GetKeyID()
+
+	// Simulate the key-rotate command in a separate process: no service method is involved
+	result, err := jwkutils.RotateSigningKeys(t.Context(), db, envConfig, instanceID, "ES256", "", time.Hour, time.Now())
+	require.NoError(t, err)
+
+	// Before reloading, the running signer still uses the old key, as the reload interval has not elapsed yet
+	kidBeforeReload, _ := svc.GetKeyID()
+	assert.Equal(t, originalKid, kidBeforeReload)
+
+	// A reload aligns the signer with the persistent active generation
+	require.NoError(t, svc.ReloadSigningKeys(t.Context()))
+	newKid, _ := svc.GetKeyID()
+	assert.Equal(t, result.NewActiveKid, newKid)
+	alg, err := svc.GetKeyAlg()
+	require.NoError(t, err)
+	assert.Equal(t, "ES256", alg.String())
+
+	// The retired key remains verifiable after reload
+	_, ok := svc.GetVerificationKey(originalKid)
+	assert.True(t, ok)
+}
+
+func TestSigningKeyGenerationsCleanup(t *testing.T) {
+	db := testutils.NewDatabaseForTest(t)
+	envConfig := newTestEnvConfig()
+	instanceID, err := instanceid.Load(t.Context(), db)
+	require.NoError(t, err)
+	svc := initJwtService(t, db, instanceID, nil, envConfig)
+
+	firstKid, _ := svc.GetKeyID()
+	rotateAndReload(t, svc, "ES256", "", time.Hour)
+
+	// Both keys are published before the deadline
+	_, ok := svc.GetVerificationKey(firstKid)
+	require.True(t, ok)
+
+	// Force the retired generation past its retain-until deadline, then run the cleanup job
+	expireRetiredGeneration(t, db, envConfig, instanceID)
+	count, err := svc.CleanupExpiredRetiredKeys(t.Context())
+	require.NoError(t, err)
+	assert.Equal(t, 1, count)
+
+	// The expired retired key is gone, while the active key keeps signing
+	_, ok = svc.GetVerificationKey(firstKid)
+	assert.False(t, ok, "Keys past their compatibility window must be removed from the JWKS")
+	activeKid, _ := svc.GetKeyID()
+	assert.NotEqual(t, firstKid, activeKid)
+
+	// Running the cleanup again is a safe, idempotent no-op
+	count, err = svc.CleanupExpiredRetiredKeys(t.Context())
+	require.NoError(t, err)
+	assert.Equal(t, 0, count)
+}
+
+func TestSigningKeyGenerationsReclaimStopsVerification(t *testing.T) {
+	db := testutils.NewDatabaseForTest(t)
+	envConfig := newTestEnvConfig()
+	instanceID, err := instanceid.Load(t.Context(), db)
+	require.NoError(t, err)
+	svc := initJwtService(t, db, instanceID, nil, envConfig)
+
+	loaded, err := jwkutils.LoadSigningKeySet(t.Context(), db, envConfig, instanceID)
+	require.NoError(t, err)
+	oldKey, _ := loaded.ActiveKey()
+	oldAlg, _ := oldKey.Algorithm()
+
+	rotateAndReload(t, svc, "ES256", "", time.Hour)
+
+	// While the window is open the old token verifies
+	tokenString := signTokenForTest(t, oldAlg, oldKey, envConfig.AppURL, time.Now().Add(time.Minute))
+	keySet, err := svc.GetVerificationKeySet()
+	require.NoError(t, err)
+	_, err = jwxjwt.ParseString(tokenString, jwxjwt.WithValidate(true), jwxjwt.WithKeySet(keySet))
+	require.NoError(t, err)
+
+	// After the cleanup removes the generation the same token can no longer verify
+	expireRetiredGeneration(t, db, envConfig, instanceID)
+	_, err = svc.CleanupExpiredRetiredKeys(t.Context())
+	require.NoError(t, err)
+	keySet, err = svc.GetVerificationKeySet()
+	require.NoError(t, err)
+	_, err = jwxjwt.ParseString(tokenString, jwxjwt.WithValidate(true), jwxjwt.WithKeySet(keySet))
+	require.Error(t, err, "Verification must fail once the retired key is reclaimed")
+}
diff --git a/backend/internal/utils/jwk/signing_key_rotation.go b/backend/internal/utils/jwk/signing_key_rotation.go
new file mode 100644
index 00000000..5aed4027
--- /dev/null
+++ b/backend/internal/utils/jwk/signing_key_rotation.go
@@ -0,0 +1,444 @@
+package jwk
+
+// High-level operations on the persistent OIDC signing key set: first-run creation, legacy adoption, atomic rotation, pruning and KEK re-encryption
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	jwxjwk "github.com/lestrrat-go/jwx/v4/jwk"
+	"gorm.io/gorm"
+
+	"github.com/pocket-id/pocket-id/backend/internal/common"
+)
+
+// LoadedSigningKeySet is a signing key set together with the decrypted private key of every generation
+type LoadedSigningKeySet struct {
+	Set  *SigningKeySet
+	Keys map[string]jwxjwk.Key
+}
+
+// ActiveKey returns the decrypted private key of the active generation
+func (l *LoadedSigningKeySet) ActiveKey() (jwxjwk.Key, *SigningKeyGeneration) {
+	gen, _ := l.Set.Active()
+	if gen == nil {
+		return nil, nil
+	}
+	return l.Keys[gen.Kid], gen
+}
+
+// EnsureSigningKeySet loads the persistent set, creating it on first startup
+// It adopts the pre-generations single key row when present, otherwise generates the default RS256 key
+// A lost initialization race returns ErrRetryKeyStorage, exactly like the previous single-key flow
+func EnsureSigningKeySet(ctx context.Context, db *gorm.DB, envConfig *common.EnvConfigSchema, instanceID string, now time.Time) (*LoadedSigningKeySet, error) {
+	store, err := GetSigningKeySetStore(db, envConfig, instanceID)
+	if err != nil {
+		return nil, err
+	}
+
+	// Fast path: the set already exists, so just load and decrypt every generation
+	loaded, err := loadSetWithKeys(ctx, store)
+	if err == nil {
+		return loaded, nil
+	}
+	if !errors.Is(err, ErrSigningKeySetNotFound) {
+		return nil, err
+	}
+
+	// First run with the new schema: adopt the legacy single key so existing tokens keep their kid
+	legacyKey, err := store.LoadLegacyKey(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load legacy signing key: %w", err)
+	}
+	if legacyKey != nil {
+		set, err := newSetFromKey(legacyKey, store, now)
+		if err != nil {
+			return nil, err
+		}
+		inserted, err := store.CreateSetAndDeleteLegacy(ctx, set)
+		if err != nil {
+			return nil, fmt.Errorf("failed to adopt legacy signing key: %w", err)
+		}
+		if !inserted {
+			// Another instance adopted or created the set first; reload its version
+			return nil, ErrRetryKeyStorage
+		}
+		return loadedSetFromSet(set, store)
+	}
+
+	// Brand-new deployment: generate the default RS256 key
+	key, err := GenerateKey("RS256", "")
+	if err != nil {
+		return nil, fmt.Errorf("failed to generate new signing key: %w", err)
+	}
+	set, err := newSetFromKey(key, store, now)
+	if err != nil {
+		return nil, err
+	}
+	inserted, err := store.CreateSet(ctx, set)
+	if err != nil {
+		return nil, fmt.Errorf("failed to store new signing key set: %w", err)
+	}
+	if !inserted {
+		// Another instance generated the first key concurrently; reload the winning one
+		return nil, ErrRetryKeyStorage
+	}
+	return loadedSetFromSet(set, store)
+}
+
+// RotationResult reports what a rotation did
+type RotationResult struct {
+	// NewActiveKid is the kid of the generation that now signs new tokens
+	NewActiveKid string
+	// RetiredKid is the kid that was retired by the rotation, or empty when a fresh set was bootstrapped
+	RetiredKid string
+}
+
+// RotateSigningKeys atomically makes a freshly generated key the active generation
+// The previous active generation becomes retired and stays verifiable until the retention window elapses
+// A concurrent change to the set makes the rotation fail with ErrSigningKeySetConflict instead of risking two active generations
+func RotateSigningKeys(ctx context.Context, db *gorm.DB, envConfig *common.EnvConfigSchema, instanceID, alg, crv string, retention time.Duration, now time.Time) (RotationResult, error) {
+	if retention <= 0 {
+		retention = DefaultRetiredSigningKeyRetention()
+	}
+
+	// Generate the new key before touching the database so generation failures leave no trace
+	newKey, err := GenerateKey(alg, crv)
+	if err != nil {
+		return RotationResult{}, fmt.Errorf("failed to generate new signing key: %w", err)
+	}
+
+	store, err := GetSigningKeySetStore(db, envConfig, instanceID)
+	if err != nil {
+		return RotationResult{}, err
+	}
+
+	var result RotationResult
+	for attempt := 0; ; attempt++ {
+		err = db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+			txStore := store.WithDB(tx)
+			set, rawValue, err := txStore.LoadSet(ctx)
+			if errors.Is(err, ErrSigningKeySetNotFound) {
+				// Rotation on a never-initialized database bootstraps the set with the new key as its first active generation
+				result, err = bootstrapSetDuringRotation(ctx, txStore, newKey, now)
+				return err
+			}
+			if err != nil {
+				return err
+			}
+
+			active, _ := set.Active()
+			if active == nil {
+				return ErrSigningKeySetInvalid
+			}
+
+			// Drop generations whose compatibility window has already elapsed; this only removes keys no valid token can reference
+			kept := make([]SigningKeyGeneration, 0, len(set.Generations))
+			for _, gen := range set.Generations {
+				if gen.Expired(now) {
+					continue
+				}
+				kept = append(kept, gen)
+			}
+			set.Generations = kept
+
+			// Locate the active generation again, since pruning may have shifted its index
+			active, activeIdx := set.Active()
+			if active == nil {
+				return ErrSigningKeySetInvalid
+			}
+
+			// Retire the current active generation with the requested compatibility window
+			retiredAt := now.UTC()
+			retainUntil := now.Add(retention).UTC()
+			set.Generations[activeIdx].RetiredAt = &retiredAt
+			set.Generations[activeIdx].RetainUntil = &retainUntil
+
+			// Add the new generation as the single active one
+			generation, err := txStore.EncryptKey(newKey)
+			if err != nil {
+				return err
+			}
+			kid, _ := newKey.KeyID()
+			set.Generations = append(set.Generations, SigningKeyGeneration{
+				Kid:          kid,
+				Alg:          alg,
+				EncryptedJWK: generation,
+				CreatedAt:    now.UTC(),
+			})
+			set.ActiveKid = kid
+			set.Version++
+
+			swapped, err := txStore.CompareAndSwapSet(ctx, rawValue, set)
+			if err != nil {
+				return err
+			}
+			if !swapped {
+				// Refuse to overwrite a concurrent rotation; the operator can rerun the command
+				return ErrSigningKeySetConflict
+			}
+
+			result = RotationResult{NewActiveKid: kid, RetiredKid: active.Kid}
+			return nil
+		})
+		if err == nil {
+			return result, nil
+		}
+		if errors.Is(err, ErrSigningKeySetConflict) {
+			return RotationResult{}, err
+		}
+		// Transient SQLite write locks can occur when two rotation commands start at the exact same time
+		if attempt < 4 && isDatabaseLockedError(err) {
+			if err := sleepWithContext(ctx, 100*time.Millisecond); err != nil {
+				return RotationResult{}, err
+			}
+			continue
+		}
+		return RotationResult{}, fmt.Errorf("failed to rotate signing keys: %w", err)
+	}
+}
+
+// bootstrapSetDuringRotation creates the first set when no key exists yet
+// A legacy single key is adopted as the (immediately retired) first generation, so tokens it signed stay verifiable
+func bootstrapSetDuringRotation(ctx context.Context, store *SigningKeySetStore, newKey jwxjwk.Key, now time.Time) (RotationResult, error) {
+	legacyKey, err := store.LoadLegacyKey(ctx)
+	if err != nil {
+		return RotationResult{}, fmt.Errorf("failed to load legacy signing key: %w", err)
+	}
+
+	var generations []SigningKeyGeneration
+	result := RotationResult{}
+	if legacyKey != nil {
+		legacyGen, err := store.EncryptKey(legacyKey)
+		if err != nil {
+			return RotationResult{}, err
+		}
+		legacyKid, _ := legacyKey.KeyID()
+		legacyAlg, _ := legacyKey.Algorithm()
+		retiredAt := now.UTC()
+		generations = append(generations, SigningKeyGeneration{
+			Kid:          legacyKid,
+			Alg:          legacyAlg.String(),
+			EncryptedJWK: legacyGen,
+			CreatedAt:    now.UTC(),
+			RetiredAt:    &retiredAt,
+			RetainUntil:  &retiredAt,
+		})
+		result.RetiredKid = legacyKid
+	}
+
+	newEncrypted, err := store.EncryptKey(newKey)
+	if err != nil {
+		return RotationResult{}, err
+	}
+	newKid, _ := newKey.KeyID()
+	newAlg, _ := newKey.Algorithm()
+	generations = append(generations, SigningKeyGeneration{
+		Kid:          newKid,
+		Alg:          newAlg.String(),
+		EncryptedJWK: newEncrypted,
+		CreatedAt:    now.UTC(),
+	})
+	set := &SigningKeySet{
+		Version:     signingKeySetVersion,
+		ActiveKid:   newKid,
+		Generations: generations,
+	}
+
+	inserted, err := store.CreateSetAndDeleteLegacy(ctx, set)
+	if err != nil {
+		return RotationResult{}, err
+	}
+	if !inserted {
+		return RotationResult{}, ErrSigningKeySetConflict
+	}
+	result.NewActiveKid = newKid
+	return result, nil
+}
+
+// PruneRetiredSigningKeys deletes retired generations once their retain-until deadline has passed
+// The active generation is never removed, and a failed update leaves the set untouched so a later run can retry
+func PruneRetiredSigningKeys(ctx context.Context, db *gorm.DB, envConfig *common.EnvConfigSchema, instanceID string, now time.Time) (removedKids []string, err error) {
+	store, err := GetSigningKeySetStore(db, envConfig, instanceID)
+	if err != nil {
+		return nil, err
+	}
+
+	for attempt := 0; ; attempt++ {
+		removedKids = nil
+		err = db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+			txStore := store.WithDB(tx)
+			set, rawValue, err := txStore.LoadSet(ctx)
+			if errors.Is(err, ErrSigningKeySetNotFound) {
+				// Nothing to prune before the set exists
+				return nil
+			}
+			if err != nil {
+				return err
+			}
+
+			kept := make([]SigningKeyGeneration, 0, len(set.Generations))
+			for _, gen := range set.Generations {
+				if gen.Expired(now) {
+					removedKids = append(removedKids, gen.Kid)
+					continue
+				}
+				kept = append(kept, gen)
+			}
+			if len(removedKids) == 0 {
+				return nil
+			}
+			set.Generations = kept
+			set.Version++
+
+			swapped, err := txStore.CompareAndSwapSet(ctx, rawValue, set)
+			if err != nil {
+				return err
+			}
+			if !swapped {
+				// A rotation or another pruner changed the set; retry from the fresh row
+				return ErrSigningKeySetConflict
+			}
+			return nil
+		})
+		if err == nil {
+			return removedKids, nil
+		}
+		if errors.Is(err, ErrSigningKeySetNotFound) {
+			return nil, nil
+		}
+		if errors.Is(err, ErrSigningKeySetConflict) {
+			// A conflict here means the read set was stale; reloading and retrying cannot remove a wrong generation
+			if attempt < 4 {
+				if err := sleepWithContext(ctx, 100*time.Millisecond); err != nil {
+					return nil, err
+				}
+				continue
+			}
+			return nil, err
+		}
+		if attempt < 4 && isDatabaseLockedError(err) {
+			if err := sleepWithContext(ctx, 100*time.Millisecond); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		return nil, fmt.Errorf("failed to prune retired signing keys: %w", err)
+	}
+}
+
+// ReEncryptSigningKeySet re-wraps every generation's private JWK with a new KEK, preserving active generation and deadlines
+// A missing set is not an error, since the encryption-key-rotate command also runs on deployments still using the legacy row
+func ReEncryptSigningKeySet(ctx context.Context, db *gorm.DB, oldKek, newKek []byte) error {
+	if len(oldKek) == 0 || len(newKek) == 0 {
+		return errors.New("both the old and new encryption keys are required to re-encrypt the signing key set")
+	}
+
+	oldStore := &SigningKeySetStore{db: db, kek: oldKek}
+	set, rawValue, err := oldStore.LoadSet(ctx)
+	if errors.Is(err, ErrSigningKeySetNotFound) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("failed to load signing key set with old encryption key: %w", err)
+	}
+
+	newStore := &SigningKeySetStore{db: db, kek: newKek}
+	for i := range set.Generations {
+		key, err := oldStore.DecryptKey(set.Generations[i])
+		if err != nil {
+			return fmt.Errorf("failed to decrypt generation %q: %w", set.Generations[i].Kid, err)
+		}
+		encrypted, err := newStore.EncryptKey(key)
+		if err != nil {
+			return fmt.Errorf("failed to re-encrypt generation %q: %w", set.Generations[i].Kid, err)
+		}
+		set.Generations[i].EncryptedJWK = encrypted
+	}
+	set.Version++
+
+	swapped, err := newStore.CompareAndSwapSet(ctx, rawValue, set)
+	if err != nil {
+		return err
+	}
+	if !swapped {
+		return errors.New("the signing key set changed while re-encrypting it, please retry the encryption-key-rotate command")
+	}
+	return nil
+}
+
+// LoadSigningKeySet reads the set and decrypts every generation, used by running instances that refresh their signer
+func LoadSigningKeySet(ctx context.Context, db *gorm.DB, envConfig *common.EnvConfigSchema, instanceID string) (*LoadedSigningKeySet, error) {
+	store, err := GetSigningKeySetStore(db, envConfig, instanceID)
+	if err != nil {
+		return nil, err
+	}
+	return loadSetWithKeys(ctx, store)
+}
+
+// newSetFromKey builds the first document around an existing or freshly generated private key
+func newSetFromKey(key jwxjwk.Key, store *SigningKeySetStore, now time.Time) (*SigningKeySet, error) {
+	encrypted, err := store.EncryptKey(key)
+	if err != nil {
+		return nil, err
+	}
+	kid, _ := key.KeyID()
+	alg, _ := key.Algorithm()
+	return &SigningKeySet{
+		Version: signingKeySetVersion,
+		ActiveKid: kid,
+		Generations: []SigningKeyGeneration{{
+			Kid:          kid,
+			Alg:          alg.String(),
+			EncryptedJWK: encrypted,
+			CreatedAt:    now.UTC(),
+		}},
+	}, nil
+}
+
+func loadSetWithKeys(ctx context.Context, store *SigningKeySetStore) (*LoadedSigningKeySet, error) {
+	set, _, err := store.LoadSet(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return loadedSetFromSet(set, store)
+}
+
+func loadedSetFromSet(set *SigningKeySet, store *SigningKeySetStore) (*LoadedSigningKeySet, error) {
+	keys := make(map[string]jwxjwk.Key, len(set.Generations))
+	for _, gen := range set.Generations {
+		key, err := store.DecryptKey(gen)
+		if err != nil {
+			return nil, fmt.Errorf("failed to decrypt signing key generation %q: %w", gen.Kid, err)
+		}
+		keys[gen.Kid] = key
+	}
+	if _, ok := keys[set.ActiveKid]; !ok {
+		return nil, fmt.Errorf("%w: private key for active kid %q is missing", ErrSigningKeySetInvalid, set.ActiveKid)
+	}
+	return &LoadedSigningKeySet{Set: set, Keys: keys}, nil
+}
+
+// isDatabaseLockedError recognizes SQLite's busy/locked errors, which are safe to retry
+func isDatabaseLockedError(err error) bool {
+	if err == nil {
+		return false
+	}
+	message := strings.ToLower(err.Error())
+	return strings.Contains(message, "database is locked") || strings.Contains(message, "database table is locked") || strings.Contains(message, "database is busy")
+}
+
+// sleepWithContext waits for the delay unless the context is canceled
+func sleepWithContext(ctx context.Context, delay time.Duration) error {
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
diff --git a/backend/internal/utils/jwk/signing_key_set.go b/backend/internal/utils/jwk/signing_key_set.go
new file mode 100644
index 00000000..371b0c3a
--- /dev/null
+++ b/backend/internal/utils/jwk/signing_key_set.go
@@ -0,0 +1,348 @@
+package jwk
+
+// The OIDC token signing keys live as a persistent set of "generations" in a single "kv" row
+// One generation is active and signs new tokens; retired generations stay verifiable until their retain-until deadline passes
+// A single-row document makes switching the active generation an atomic compare-and-swap on both SQLite and Postgres
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	jwxjwk "github.com/lestrrat-go/jwx/v4/jwk"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+
+	"github.com/pocket-id/pocket-id/backend/internal/common"
+	"github.com/pocket-id/pocket-id/backend/internal/model"
+	cryptoutils "github.com/pocket-id/pocket-id/backend/internal/utils/crypto"
+)
+
+const (
+	// SigningKeysDBKey is the kv row containing the persistent set of OIDC token signing keys
+	SigningKeysDBKey = "oidc_signing_keys.json"
+
+	// signingKeySetVersion is the schema version of the persisted document
+	signingKeySetVersion = 1
+)
+
+var (
+	// ErrSigningKeySetNotFound signals that the persistent signing key set has not been created yet
+	ErrSigningKeySetNotFound = errors.New("signing key set not found")
+	// ErrSigningKeySetConflict signals that the signing key set changed between read and write, so another writer won the race
+	ErrSigningKeySetConflict = errors.New("the signing key set was modified by another process, please retry")
+	// ErrSigningKeySetInvalid signals that the persisted signing key set does not contain exactly one active generation
+	ErrSigningKeySetInvalid = errors.New("persisted signing key set is invalid")
+)
+
+// DefaultRetiredSigningKeyRetention is how long a retired signing key remains published for verification after rotation
+// It covers the longest configurable OIDC token lifetime, so every token issued before rotation stays verifiable until it expires
+func DefaultRetiredSigningKeyRetention() time.Duration {
+	return time.Duration(model.MaxTokenDurationMinutes) * time.Minute
+}
+
+// SigningKeyGeneration is one generation of the OIDC signing key, with its private JWK encrypted at rest
+type SigningKeyGeneration struct {
+	// Kid identifies the key in JWS headers and the JWKS
+	Kid string
+	// Alg is the JWA signature algorithm the key was generated for
+	Alg string
+	// EncryptedJWK is the base64-encoded KEK ciphertext of the private JWK
+	EncryptedJWK string
+	// CreatedAt is when the generation was created
+	CreatedAt time.Time
+	// RetiredAt is when the generation stopped being the active one, or nil while it is active
+	RetiredAt *time.Time
+	// RetainUntil is when a retired generation may stop being published in the JWKS and be deleted
+	RetainUntil *time.Time
+}
+
+// Active reports whether the generation is the current signing generation
+func (g SigningKeyGeneration) Active() bool {
+	return g.RetiredAt == nil
+}
+
+// Expired reports whether a retired generation has passed its retain-until deadline
+func (g SigningKeyGeneration) Expired(now time.Time) bool {
+	return !g.Active() && g.RetainUntil != nil && !g.RetainUntil.After(now)
+}
+
+// SigningKeySet is the persistent document: one active generation and zero or more retired generations
+type SigningKeySet struct {
+	Version     int
+	ActiveKid   string
+	Generations []SigningKeyGeneration
+}
+
+// Active returns the active generation and its index
+func (s *SigningKeySet) Active() (*SigningKeyGeneration, int) {
+	for i := range s.Generations {
+		if s.Generations[i].Kid == s.ActiveKid {
+			return &s.Generations[i], i
+		}
+	}
+	return nil, -1
+}
+
+// Validate enforces the invariant the rest of the code relies on: exactly one active generation, and it must match ActiveKid
+func (s *SigningKeySet) Validate() error {
+	if s == nil || s.Version == 0 {
+		return fmt.Errorf("%w: missing version", ErrSigningKeySetInvalid)
+	}
+	if s.ActiveKid == "" {
+		return fmt.Errorf("%w: no active key id", ErrSigningKeySetInvalid)
+	}
+
+	activeCount := 0
+	kids := make(map[string]struct{}, len(s.Generations))
+	for i := range s.Generations {
+		gen := &s.Generations[i]
+		if gen.Kid == "" || gen.EncryptedJWK == "" {
+			return fmt.Errorf("%w: generation %d is missing key material", ErrSigningKeySetInvalid, i)
+		}
+		if _, exists := kids[gen.Kid]; exists {
+			return fmt.Errorf("%w: duplicate key id %q", ErrSigningKeySetInvalid, gen.Kid)
+		}
+		kids[gen.Kid] = struct{}{}
+		if gen.Active() {
+			activeCount++
+		}
+	}
+
+	if activeCount != 1 {
+		return fmt.Errorf("%w: expected exactly one active generation, found %d", ErrSigningKeySetInvalid, activeCount)
+	}
+	if _, ok := kids[s.ActiveKid]; !ok {
+		return fmt.Errorf("%w: active key id %q is not among the stored generations", ErrSigningKeySetInvalid, s.ActiveKid)
+	}
+	return nil
+}
+
+// Persisted DTOs keep the on-disk format explicit and independent of the domain types
+type signingKeyGenerationDTO struct {
+	Kid          string     `json:"kid"`
+	Alg          string     `json:"alg"`
+	EncryptedJWK string     `json:"encrypted_jwk"`
+	CreatedAt    time.Time  `json:"created_at"`
+	RetiredAt    *time.Time `json:"retired_at,omitempty"`
+	RetainUntil  *time.Time `json:"retain_until,omitempty"`
+}
+
+type signingKeySetDTO struct {
+	Version     int                       `json:"version"`
+	ActiveKid   string                    `json:"active_kid"`
+	Generations []signingKeyGenerationDTO `json:"generations"`
+}
+
+func (s *SigningKeySet) toDTO() *signingKeySetDTO {
+	dto := &signingKeySetDTO{
+		Version:     s.Version,
+		ActiveKid:   s.ActiveKid,
+		Generations: make([]signingKeyGenerationDTO, len(s.Generations)),
+	}
+	for i, gen := range s.Generations {
+		dto.Generations[i] = signingKeyGenerationDTO(gen)
+	}
+	return dto
+}
+
+func (d *signingKeySetDTO) toSet() *SigningKeySet {
+	set := &SigningKeySet{
+		Version:     d.Version,
+		ActiveKid:   d.ActiveKid,
+		Generations: make([]SigningKeyGeneration, len(d.Generations)),
+	}
+	for i, gen := range d.Generations {
+		set.Generations[i] = SigningKeyGeneration(gen)
+	}
+	return set
+}
+
+// SigningKeySetStore reads and writes the persistent signing key set, encrypting every private JWK with the KEK
+type SigningKeySetStore struct {
+	db  *gorm.DB
+	kek []byte
+}
+
+// GetSigningKeySetStore returns the store for the persistent OIDC token signing key set
+func GetSigningKeySetStore(db *gorm.DB, envConfig *common.EnvConfigSchema, instanceID string) (*SigningKeySetStore, error) {
+	kek, err := LoadKeyEncryptionKey(envConfig, instanceID)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load encryption key: %w", err)
+	}
+	if len(kek) == 0 {
+		return nil, errors.New("an encryption key is required for the signing key set")
+	}
+	return &SigningKeySetStore{db: db, kek: kek}, nil
+}
+
+// WithDB returns a store using the given transaction, keeping the same KEK
+func (s *SigningKeySetStore) WithDB(db *gorm.DB) *SigningKeySetStore {
+	return &SigningKeySetStore{db: db, kek: s.kek}
+}
+
+// LoadSet reads and parses the persistent set, returning the exact raw row value needed for a compare-and-swap
+// A missing row returns ErrSigningKeySetNotFound so callers can distinguish "not initialized yet" from database errors
+func (s *SigningKeySetStore) LoadSet(ctx context.Context) (set *SigningKeySet, rawValue string, err error) {
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+
+	row := model.KV{Key: SigningKeysDBKey}
+	err = s.db.WithContext(ctx).First(&row).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, "", ErrSigningKeySetNotFound
+	} else if err != nil {
+		return nil, "", fmt.Errorf("failed to retrieve signing key set from the database: %w", err)
+	}
+	if row.Value == nil || *row.Value == "" {
+		return nil, "", ErrSigningKeySetNotFound
+	}
+
+	set, err = decodeSigningKeySet([]byte(*row.Value))
+	if err != nil {
+		return nil, "", err
+	}
+	return set, *row.Value, nil
+}
+
+// CreateSet inserts the set only if no row exists yet, which serializes first-time initialization across instances
+func (s *SigningKeySetStore) CreateSet(ctx context.Context, set *SigningKeySet) (inserted bool, err error) {
+	value, err := s.encodeSet(set)
+	if err != nil {
+		return false, err
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	result := s.db.
+		WithContext(ctx).
+		Clauses(clause.OnConflict{
+			Columns:   []clause.Column{{Name: "key"}},
+			DoNothing: true,
+		}).
+		Create(&model.KV{Key: SigningKeysDBKey, Value: &value})
+	if result.Error != nil {
+		return false, fmt.Errorf("failed to store signing key set: %w", result.Error)
+	}
+	return result.RowsAffected == 1, nil
+}
+
+// CreateSetAndDeleteLegacy inserts the set and, only for the winning inserter, removes the superseded single-key row
+// Both statements run in one transaction so a crash can never leave the adoption half-applied
+func (s *SigningKeySetStore) CreateSetAndDeleteLegacy(ctx context.Context, set *SigningKeySet) (inserted bool, err error) {
+	value, err := s.encodeSet(set)
+	if err != nil {
+		return false, err
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		result := tx.
+			Clauses(clause.OnConflict{
+				Columns:   []clause.Column{{Name: "key"}},
+				DoNothing: true,
+			}).
+			Create(&model.KV{Key: SigningKeysDBKey, Value: &value})
+		if result.Error != nil {
+			return fmt.Errorf("failed to store signing key set: %w", result.Error)
+		}
+		inserted = result.RowsAffected == 1
+
+		// Only the writer that actually created the row may remove the legacy key, so a losing adopter can't delete it
+		if inserted {
+			if err := tx.Delete(&model.KV{}, "key = ?", PrivateKeyDBKey).Error; err != nil {
+				return fmt.Errorf("failed to remove legacy signing key row: %w", err)
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		return false, err
+	}
+	return inserted, nil
+}
+
+// CompareAndSwapSet replaces the row value only if it still equals the raw value that was read
+// A zero affected count means another process changed the set first
+func (s *SigningKeySetStore) CompareAndSwapSet(ctx context.Context, previousRawValue string, set *SigningKeySet) (swapped bool, err error) {
+	value, err := s.encodeSet(set)
+	if err != nil {
+		return false, err
+	}
+
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Second)
+	defer cancel()
+	result := s.db.
+		WithContext(ctx).
+		Model(&model.KV{}).
+		Where("key = ? AND value = ?", SigningKeysDBKey, previousRawValue).
+		Update("value", value)
+	if result.Error != nil {
+		return false, fmt.Errorf("failed to update signing key set: %w", result.Error)
+	}
+	return result.RowsAffected == 1, nil
+}
+
+// LoadLegacyKey loads the single-key row used before signing key generations existed
+// It returns nil when the row is absent
+func (s *SigningKeySetStore) LoadLegacyKey(ctx context.Context) (jwxjwk.Key, error) {
+	provider := &KeyProviderDatabase{db: s.db, kek: s.kek, dbKey: PrivateKeyDBKey}
+	return provider.LoadKey(ctx)
+}
+
+// EncryptKey stores a private JWK as a base64-encoded KEK ciphertext
+func (s *SigningKeySetStore) EncryptKey(key jwxjwk.Key) (string, error) {
+	data, err := EncodeJWKBytes(key)
+	if err != nil {
+		return "", fmt.Errorf("failed to encode key to JSON: %w", err)
+	}
+	enc, err := cryptoutils.Encrypt(s.kek, data, nil)
+	if err != nil {
+		return "", fmt.Errorf("failed to encrypt key: %w", err)
+	}
+	return base64.StdEncoding.EncodeToString(enc), nil
+}
+
+// DecryptKey parses a generation's private JWK back into a jwk.Key
+func (s *SigningKeySetStore) DecryptKey(generation SigningKeyGeneration) (jwxjwk.Key, error) {
+	enc, err := base64.StdEncoding.DecodeString(generation.EncryptedJWK)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read encrypted key for kid %q: not a valid base64 value: %w", generation.Kid, err)
+	}
+	data, err := cryptoutils.Decrypt(s.kek, enc, nil)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decrypt key for kid %q: %w", generation.Kid, err)
+	}
+	key, err := jwxjwk.ParseKey(data)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse encrypted key for kid %q: %w", generation.Kid, err)
+	}
+	return key, nil
+}
+
+func (s *SigningKeySetStore) encodeSet(set *SigningKeySet) (string, error) {
+	if err := set.Validate(); err != nil {
+		return "", err
+	}
+	data, err := json.Marshal(set.toDTO())
+	if err != nil {
+		return "", fmt.Errorf("failed to encode signing key set: %w", err)
+	}
+	return string(data), nil
+}
+
+func decodeSigningKeySet(data []byte) (*SigningKeySet, error) {
+	var dto signingKeySetDTO
+	if err := json.Unmarshal(data, &dto); err != nil {
+		return nil, fmt.Errorf("failed to parse signing key set: %w", err)
+	}
+	set := dto.toSet()
+	if err := set.Validate(); err != nil {
+		return nil, err
+	}
+	return set, nil
+}
